<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                 https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="biztrackPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.biztrackpro.entity.Tenant</class>
        <class>com.biztrackpro.entity.Order</class>
        <class>com.biztrackpro.entity.Expense</class>
        <class>com.biztrackpro.entity.AdCampaign</class>
        <class>com.biztrackpro.entity.ProductCost</class>
        <class>com.biztrackpro.entity.BusinessProfile</class>
        <class>com.biztrackpro.entity.SystemProperty</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- Connection (overridden at runtime from environment variables by EntityManagerProducer) -->
            <property name="hibernate.connection.driver_class" value="com.mysql.cj.jdbc.Driver"/>
            <property name="hibernate.connection.url" value="jdbc:mysql://localhost:3306/biztrackpro?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=Asia/Kolkata&amp;characterEncoding=UTF-8"/>
            <property name="hibernate.connection.username" value="biztrack"/>
            <property name="hibernate.connection.password" value="biztrack"/>

            <!-- HikariCP as the connection pool -->
            <property name="hibernate.connection.provider_class"
                      value="org.hibernate.hikaricp.internal.HikariCPConnectionProvider"/>
            <property name="hibernate.hikari.maximumPoolSize" value="10"/>
            <property name="hibernate.hikari.minimumIdle" value="2"/>
            <property name="hibernate.hikari.idleTimeout" value="300000"/>
            <property name="hibernate.hikari.connectionTimeout" value="20000"/>
            <property name="hibernate.hikari.poolName" value="BizTrackHikariPool"/>

            <!-- Hibernate ORM -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>
            <property name="hibernate.jdbc.time_zone" value="Asia/Kolkata"/>
        </properties>
    </persistence-unit>
</persistence>
